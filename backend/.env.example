# === QUI PERD — Backend (exemple) ===
# Copier en .env et renseigner chaque secret. Ne jamais committer .env.

# Application
APP_ENV=development
# Interface d'écoute : vide = toutes les interfaces (dev). En production derrière Caddy : 127.0.0.1.
APP_HOST=
APP_PORT=8080
APP_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:3000
# Adresse publique du frontend, utilisée pour fabriquer les liens des e-mails
# (réinitialisation de mot de passe). Par défaut : CORS_ORIGIN.
SITE_URL=http://localhost:3000

# Temps réel (WebSocket sur GET /api/temps-reel)
# Origines supplémentaires autorisées à ouvrir le socket, séparées par des virgules.
# CORS_ORIGIN est TOUJOURS admise : cette variable sert aux origines en plus (domaine
# public du tunnel Cloudflare, préproduction, adresse du serveur en réseau local…).
# Une origine absente des deux listes est refusée dès la poignée de main : c'est la
# protection contre le détournement de socket inter-site (CSWSH). Une requête sans
# en-tête Origin (application mobile) reste acceptée. `*` désactive le contrôle et
# ne doit JAMAIS être utilisé en production.
# Exemple : WS_ORIGINES_AUTORISEES=https://quiperd.mon-domaine.fr,http://192.168.1.50
WS_ORIGINES_AUTORISEES=
# Durée de vie du ticket d'ouverture de socket (POST /api/temps-reel/ticket), en
# secondes. Le ticket est à usage unique : il est consommé atomiquement (GETDEL) à
# l'upgrade. 60 s suffisent largement à l'aller-retour navigateur.
WS_TICKET_TTL_SECONDES=60

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=qui_perd
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-moi-32-octets-minimum-aleatoire
JWT_EXPIRATION_HEURES=72

# Stockage des preuves de match (disque local)
STOCKAGE_PREUVES_DIR=public/preuves
UPLOAD_MAX_MO=50

# Seed — compte administrateur de test (à supprimer avant ouverture publique)
SEED_ADMIN_NOM=Administrateur
SEED_ADMIN_EMAIL=admin@quiperd.local
SEED_ADMIN_MOTDEPASSE=Admin1234!

# Paiement — LigdiCash
LIGDICASH_API_KEY=
LIGDICASH_API_TOKEN=
LIGDICASH_BASE_URL=https://app.ligdicash.com/pay/v01
LIGDICASH_CALLBACK_URL=http://localhost:8080/api/paiements/callback-ligdicash

# Paiement — MoneyFusion (URL sans www. — voir skill FusionMoney §5)
# En recette locale, pointer la doublure plutôt que la vraie passerelle :
#   go build -o quiperd-stub-fusion.exe ./tests/outils/stub-fusion && ./quiperd-stub-fusion.exe -port 8099
#   FUSIONMONEY_API_URL=http://127.0.0.1:8099/quiperd/paiement
# Sans au moins un prestataire CONFIGURÉ, le dépôt est refusé (400) et les
# parcours de recette ne peuvent plus créditer les comptes de test.
FUSIONMONEY_API_URL=
FUSIONMONEY_CALLBACK_URL=http://localhost:8080/api/paiements/callback-fusion

# Prestataires actifs (csv): ligdicash,fusionmoney
# Un prestataire n'est proposé au joueur (GET /api/paiements/prestataires) que
# s'il est listé ICI **et** effectivement configuré au-dessus.
PAIEMENT_PRESTATAIRES=ligdicash,fusionmoney

# Firebase Cloud Messaging (push). Laisser FCM_ACTIF=false en dev sans clés.
FCM_ACTIF=false
FCM_CREDENTIALS_FILE=

# Envoi d'e-mails (code de confirmation d'inscription, réinitialisation de mot de passe,
# accusé de demande de retrait). STARTTLS sur le port 587 chez Office 365 / Gmail.
# EMAIL_ACTIF=false en développement : les messages sont alors seulement journalisés.
EMAIL_ACTIF=false
EMAIL_EXPEDITEUR=QUI PERD <no-reply@exemple.com>
SMTP_HOTE=smtp.office365.com
SMTP_PORT=587
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
