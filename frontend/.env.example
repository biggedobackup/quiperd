# === QUI PERD — Frontend (exemple) ===
# Variables lues côté serveur uniquement (server functions / routes serveur). Aucune variable VITE_* :
# rien de sensible n'est exposé au navigateur.

# URL de l'API backend Go — 127.0.0.1 et non localhost (résolution ::1 d'abord sous Windows).
API_BASE_URL=http://127.0.0.1:8080/api

# Origine publique du frontend (liens absolus Open Graph, sitemap).
SITE_URL=http://localhost:3000

# URL PUBLIQUE du hub WebSocket temps réel, telle que le navigateur doit l'ouvrir.
# C'est la seule adresse du backend qui sorte côté navigateur : elle est renvoyée par la server
# function `obtenirTicketTempsReel` avec un ticket à usage unique (le cookie HttpOnly ne peut pas
# être envoyé par une balise WebSocket).
# Facultative : sans elle, elle est déduite de API_BASE_URL (http:// → ws://, https:// → wss://,
# chemin /temps-reel), ce qui suffit en développement.
# En production, mettre l'adresse publique derrière Caddy / le tunnel Cloudflare, PAS l'adresse
# interne du conteneur : WS_PUBLIC_URL=wss://api.exemple.com/api/temps-reel
# WS_PUBLIC_URL=ws://127.0.0.1:8080/api/temps-reel

# Attribut Secure des cookies : déduit de SITE_URL (https:// = Secure). NODE_ENV=production pour le serveur Node/Bun.
NODE_ENV=development

# Téléchargement de l'application joueur, affiché sur l'accueil (section 06).
# Laisser vide tant que l'application n'est pas publiée : la plateforme concernée s'affiche
# alors « Bientôt disponible » au lieu d'un lien de magasin qui ne mène nulle part.
# APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.defisenligne.app
# APP_IOS_URL=https://apps.apple.com/app/qui-perd/id000000000
APP_ANDROID_URL=
APP_IOS_URL=
