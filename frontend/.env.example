# === QUI PERD — Frontend (exemple) ===
# Variables lues côté serveur uniquement (server functions / routes serveur). Aucune variable VITE_* :
# rien de sensible n'est exposé au navigateur.

# URL de l'API backend Go — 127.0.0.1 et non localhost (résolution ::1 d'abord sous Windows).
API_BASE_URL=http://127.0.0.1:8080/api

# Origine publique du frontend (liens absolus Open Graph, sitemap).
SITE_URL=http://localhost:3000

# production : force l'attribut Secure sur les cookies de session
NODE_ENV=development
