<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Défis en Ligne</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>defisenligne</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Pendant iOS de `lib/noyau/reseau.dart` et du `network_security_config` Android :
	     l'API interne répond en HTTP en clair ou en HTTPS avec un certificat auto-signé,
	     que l'App Transport Security refuse par défaut. Une version destinée à l'App Store
	     doit retirer ce bloc et compiler avec `--dart-define=RESEAU_PERMISSIF=false`. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- iOS 14+ demande l'accord du joueur avant de joindre une machine du réseau local. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Défis en Ligne se connecte au serveur de la plateforme sur votre réseau local.</string>
	<!-- Lien profond par schéma propre : defisenligne://defis/<id> ouvre la fiche du défi.
	     Le lien https, lui, demande un « Universal Link » : capacité Associated Domains dans
	     Xcode (applinks:defisenligne.com) ET un fichier apple-app-site-association servi par le
	     site. Tant que ces deux-là ne sont pas en place, un lien https reste au navigateur —
	     la page publique du site fait alors le travail. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.defisenligne.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>defisenligne</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
