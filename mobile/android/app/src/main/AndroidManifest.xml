<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Appels à l'API, socket temps réel et images distantes. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Notifications push. Depuis Android 13 la permission se DEMANDE à l'exécution : la
         déclarer ici ne suffit pas, l'application doit la solliciter (voir services/push.dart). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="Défis en Ligne"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Liens profonds — un lien de défi partagé ouvre l'application, pas le navigateur.

                 Deux filtres, et ils ne font pas le même travail :

                 1. LE LIEN WEB (http/https vers <deepLinkHost>/defis/<id>). C'est celui qui
                    circule dans WhatsApp ou un SMS. `android:autoVerify="true"` en fait un
                    « App Link » : depuis Android 12, un lien https n'ouvre l'application QUE si
                    le domaine l'a explicitement autorisée en publiant
                    https://<domaine>/.well-known/assetlinks.json avec l'empreinte SHA-256 du
                    certificat de signature. Sans ce fichier, le lien reste au navigateur — ce
                    qui n'est pas une panne : la page publique du site fait le travail.
                 2. LE SCHÉMA PROPRE (defisenligne://defis/<id>), qui ne demande aucune vérification
                    de domaine. Il sert au développement et de porte de secours. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${deepLinkHost}" android:pathPrefix="/defis/"/>
                <data android:scheme="http" android:host="${deepLinkHost}" android:pathPrefix="/defis/"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="defisenligne" android:host="defis"/>
            </intent-filter>
        </activity>
        <!-- Canal, icône et teinte utilisés quand un message FCM arrive alors que l'application
             est FERMÉE : c'est le système qui dessine la bannière, il ne passe pas par le code
             Dart. Le canal doit porter le même identifiant que celui créé côté application ET
             que celui envoyé par le serveur (backend/utils/fcm.go), sinon Android en fabrique un
             second, sans son, et les notifications tombent sans se faire remarquer. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="defis_en_ligne_defaut" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/couleur_notification" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
