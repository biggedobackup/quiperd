<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- La politique réseau (HTTP en clair + certificats installés sur l'appareil)
         est désormais dans le source set `main` : elle s'applique à tous les types de
         compilation, pas seulement à `debug`. Voir `main/res/xml/network_security_config.xml`. -->
</manifest>
