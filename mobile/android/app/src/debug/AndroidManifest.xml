<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- HTTP en clair, pour le développement seulement.
         `main` ne le déclare plus : l'APK distribué aux joueurs ne parle qu'en HTTPS. -->
    <application android:usesCleartextTraffic="true" />

    <!-- La politique réseau permissive (HTTP en clair vers 10.0.2.2, et les certificats
         installés sur l'appareil traités comme des autorités valides) vit dans
         `debug/res/xml/network_security_config.xml` : Android la substitue à celle du source
         set `main`, qui est stricte. Rien à commenter ni décommenter à la main. -->
</manifest>
